pipeline {
  agent any
  // Chạy mỗi 15 phút
  triggers { cron('H/15 * * * *') }
  options { disableConcurrentBuilds(); timeout(time: 20, unit: 'MINUTES') }
  environment {
    AWS_DEFAULT_REGION = 'ap-southeast-1'
    CLUSTER = 'gymnote-eks'
  }
  stages {
    stage('Dọn môi trường preview') {
      steps {
        sh '''
          # Stack đang bị hủy (không có cluster) thì không có gì để dọn
          if ! aws eks describe-cluster --name "$CLUSTER" >/dev/null 2>&1; then
            echo "Không có cluster $CLUSTER, bỏ qua"; exit 0
          fi
          aws eks update-kubeconfig --name "$CLUSTER"
          chmod +x scripts/*.sh
          scripts/preview-cleanup.sh
        '''
      }
    }
  }
}